# =====================================================================
#  DSC Signer – configuration. Copy to .env (install_windows.ps1 does this
#  for you and fills SECRET_KEY). NEVER commit .env: it holds the token PIN.
# =====================================================================

# ---------- USB token (PKCS#11) ----------
# 64-bit PKCS#11 DLL of your token driver. Feitian ePass 2003: eps2003csp11.dll (or eps2003csp11v2.dll)
# Hypersecu HYP2003 (HyperPKI): C:\Windows\System32\HYP2003csp11IND.dll
PKCS11_LIB_PATH=C:\Windows\System32\eps2003csp11.dll
# Token label shown by `python scripts\list_token.py`. Blank = use the token that is plugged in.
TOKEN_LABEL=
# User PIN of the token. Remote users never see or type it.
# WARNING: the token locks after several wrong PINs. The app stops retrying after one rejection.
TOKEN_PIN=
# Optional: part of the certificate label or holder name to pick a specific certificate
CERT_LABEL=
# Set true only if signing fails with a "mechanism invalid" error
PKCS11_USE_RAW_MECHANISM=false

# pkcs11 = USB token (normal use). pkcs12 = .pfx file, for testing without the token.
SIGNER_BACKEND=pkcs11
PKCS12_PATH=
PKCS12_PASSPHRASE=

# ---------- Signature appearance ----------
# Optional RFC 3161 timestamp server, e.g. http://timestamp.digicert.com
TSA_URL=
# Defaults shown in the upload form (users can change them per upload)
SIGN_REASON=
SIGN_LOCATION=
SIGN_TIMEZONE=Asia/Kolkata
MAX_SIGNATURES_PER_DOC=50

# ---------- Security ----------
# 64 hex chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# First super-admin, created only when the database has no users.
# Remove INITIAL_ADMIN_PASS from this file after the first start.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=
SESSION_HOURS=12
# Keep true (Cloudflare serves HTTPS; browsers accept Secure cookies on http://localhost)
COOKIE_SECURE=true
# Initial state of the global IP whitelist. After first start, toggle it in the Admin Panel.
ENFORCE_GLOBAL_IP_WHITELIST=false
# Only requests coming from these peers may set CF-Connecting-IP / X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1
# true = Admin Panel only reachable from the host machine itself
ADMIN_LOCALHOST_ONLY=false
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# ---------- Files ----------
FILE_RETENTION_MINUTES=60
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=20

# ---------- Server ----------
# Keep 127.0.0.1: cloudflared connects locally, nothing is exposed on the LAN.
HOST=127.0.0.1
PORT=8000
